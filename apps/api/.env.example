# EKIP API — environment configuration (ADR-0006: secrets never committed).
# Copy to .env for local development. .env is git-ignored.

# --- App ---
EKIP_ENV=development
EKIP_LOG_LEVEL=INFO

# --- PostgreSQL (system of record) ---
EKIP_POSTGRES_DSN=postgresql+asyncpg://ekip:ekip@localhost:5432/ekip

# --- Neo4j (knowledge graph) ---
EKIP_NEO4J_URI=bolt://localhost:7687
EKIP_NEO4J_USER=neo4j
EKIP_NEO4J_PASSWORD=ekip-dev-password

# --- Qdrant (vector store) ---
EKIP_QDRANT_URL=http://localhost:6333

# --- CORS (comma-separated origins for the web app) ---
EKIP_CORS_ORIGINS=http://localhost:3000

# --- Auth (ADR-0008) — OVERRIDE THESE IN STAGING/PRODUCTION ---
# JWT bearer verification is the production security boundary.
EKIP_JWT_SECRET=dev-insecure-jwt-secret-change-me
EKIP_JWT_ALGORITHM=HS256
# Optional OIDC validation (leave blank to skip):
# EKIP_JWT_AUDIENCE=
# EKIP_JWT_ISSUER=
# Dev-only header principal fallback; MUST be false in production:
EKIP_DEV_AUTH_ENABLED=true
# Symmetric key for encrypting connector secrets at rest:
EKIP_SECRET_KEY=dev-insecure-secret-key-change-me

# --- Schema bootstrap (dev convenience; use migrations in production) ---
EKIP_AUTO_CREATE_SCHEMA=true
